# Azure resource configuration (replace placeholders locally; never commit .env)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=D365-DEV-RG
AZURE_VM_NAME=D365DEVVM01

# Safety defaults: only DEV and TEST are accepted.
AZURE_ENVIRONMENT=DEV
ALLOWED_ENVIRONMENTS=DEV,TEST
FRONTEND_ORIGIN=http://localhost:5500
